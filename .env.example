# 원격 동기화 (Cloudflare Worker 배포 URL) — 있으면 localStorage 대신 D1 사용
# 이 파일을 복사: cp .env.example .env.local  후 VITE_API_URL 을 채우세요.
# VITE_API_URL=https://369stage-api.oin0ojy.workers.dev

# Firebase (Google 로그인) — Firebase 콘솔 > 프로젝트 설정 > 내 앱에서 확인
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
